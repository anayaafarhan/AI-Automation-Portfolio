# Generated output — keep the folder, not the renders
output/*.mp4
output/storyboard.json
!output/.gitkeep

# User-supplied audio — keep the folder, not the files
music/*
!music/.gitkeep

# Property assets — keep the folder, not the files
input/*
!input/.gitkeep

__pycache__/
*.pyc

# Your real client config (property name/location/amenities) — keep
# config.example.json as the tracked template only
config.json
